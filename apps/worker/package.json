{
  "name": "@tracker/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "trigger": "tsx src/scripts/trigger.ts",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@tracker/db": "workspace:*",
    "@tracker/reminders": "workspace:*",
    "@tracker/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "mongoose": "^8.9.5",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "description": "Manual reminder trigger CLI. The scheduled dispatch is cron-driven via the API — see ARCHITECTURE.md §5."
