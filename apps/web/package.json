    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@serwist/next": "^9.0.11",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "rimraf": "^6.0.1",
    "serwist": "^9.0.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
