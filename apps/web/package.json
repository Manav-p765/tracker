{
  "name": "@tracker/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-icons.mjs && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
