# =============================================================================
# tracker — env template (ARCHITECTURE.md §9)
#
# Copy the relevant block into apps/<app>/.env. Never commit a real .env.
# Every app validates these with Zod at boot and exits non-zero if one is missing.
#
#   VAPID keys : npx web-push generate-vapid-keys
#   JWT secrets: openssl rand -base64 48
# =============================================================================

# -----------------------------------------------------------------------------
# apps/api  (Express + Socket.IO)  — wired in Prompt 0.2
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/tracker
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:3000

# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
# SERVER ONLY. Never ship to the client, never log.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

SENTRY_DSN=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# apps/worker  (BullMQ)  — wired in Prompt 2.2
# Reuses NODE_ENV, MONGODB_URI, REDIS_URL, VAPID_*, SENTRY_DSN, LOG_LEVEL above.
# -----------------------------------------------------------------------------
# How often the reminder sweep runs, in minutes. Must be <= the narrowest scan window.
SCAN_INTERVAL_MINUTES=5

# LLM extraction for the Vault — leave unset until Prompt 3.2
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# -----------------------------------------------------------------------------
# apps/web  (Next.js PWA)
# NEXT_PUBLIC_* is inlined into the browser bundle — never put a secret here.
# The client fetches the VAPID public key from GET /push/vapid-public-key.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=
