{
  "name": "@tracker/reminders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reminder scanning and web-push delivery. Shared by the API's cron dispatch and the CLI.",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@tracker/db": "workspace:*",
    "@tracker/shared": "workspace:*",
    "mongoose": "^8.9.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^10.1.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
