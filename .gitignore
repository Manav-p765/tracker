# dependencies
node_modules/
.pnpm-store/

# builds
dist/
.next/
out/
*.tsbuildinfo

# generated by Serwist at build time — never commit
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js

# env — never commit a real one; .env.example is the tracked template
.env
.env.*
!.env.example

# tooling caches
.turbo/
coverage/
.eslintcache

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# local dev database (dev-mongo.mjs writes outside the repo by default)
.mongo-data/
